# Optional. Without a key the app uses its built-in rule-based sorter,
# so the demo works with no setup at all.
GROQ_API_KEY=

# Optional. Any Groq chat model that supports JSON output.
GROQ_MODEL=llama-3.3-70b-versatile

# Optional kill switch: false (or 0 / off / no) turns AI off without removing
# the key, so the built-in rules sort everything.
AI_ENABLED=true

# Optional. AI calls each visitor gets per day (sorting and learning both count).
# Each IP address gets three times this. Over the limit, the rules take over.
AI_DAILY_LIMIT=20
